# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.
#
# For the offline demo (DEMO_MODE=true, WATSONX_ENABLED=false, NETWORK_REQUIRED=false)
# none of the variables below are required.  The application uses in-memory DuckDB
# seeded from synthetic data — no external service is contacted.

# ── Core demo flags ─────────────────────────────────────────────────────────
DEMO_MODE=true
WATSONX_ENABLED=false
NETWORK_REQUIRED=false

# ── IBM watsonx.ai — optional, for live Granite explanation layer ────────────
# Only consulted when WATSONX_ENABLED=true.
# WATSONX_API_KEY=your_api_key_here
# WATSONX_PROJECT_ID=your_project_id_here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Application ──────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# ── Not used in demo mode ────────────────────────────────────────────────────
# DATABASE_URL is NOT used — ChainShield uses DuckDB :memory: only.
# SLACK_WEBHOOK_URL is NOT used — no outbound notifications in the offline demo.
